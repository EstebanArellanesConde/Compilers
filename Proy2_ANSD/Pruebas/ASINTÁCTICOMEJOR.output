Terminals unused in grammar

    ATOM_OPREL


Grammar

    0 $accept: programa $end

    1 programa: list_dec_glob func otra_func

    2 list_dec_glob: dec_global list_dec_glob
    3              | ε

    4 dec_global: ATOM_GLOBAL tipo ATOM_ID list_id ATOM_PUNTO_COMA

    5 tipo: ATOM_BOOL
    6     | ATOM_CADE
    7     | ATOM_ENT
    8     | ATOM_FLOTA

    9 list_id: ATOM_COMA ATOM_ID list_id
   10        | ε

   11 func: tipo ATOM_ID ATOM_PAR_IZQ arg ATOM_PAR_DER ATOM_COR_IZQ cuerpo ATOM_COR_DER

   12 otra_func: func otra_func
   13          | ε

   14 arg: tipo ATOM_ID list_arg

   15 list_arg: ATOM_COMA arg
   16         | ε

   17 cuerpo: lista_dec lista_sent

   18 lista_dec: dec_global lista_dec
   19          | ε

   20 lista_sent: sent lista_sent
   21           | ε

   22 sent: asig
   23     | haz_mientras
   24     | si
   25     | para
   26     | dev
   27     | ATOM_CONTINUAR ATOM_PUNTO
   28     | ATOM_PARAR ATOM_PUNTO

   29 asig: ATOM_ID op_asig ATOM_PUNTO_COMA

   30 op_asig: op_asig_simple expr_gral
   31        | op_asig_comp expr_gral

   32 op_asig_simple: ATOM_ASIG

   33 op_asig_comp: ATOM_OPASIG

   34 expr_gral: ATOM_CADENA
   35          | ATOM_FALS
   36          | ATOM_VER
   37          | ATOM_NULO
   38          | expr

   39 expr: term expr_prime

   40 expr_prime: '+' term expr_prime
   41           | '-' term expr_prime
   42           | ε

   43 term: factor term_prime

   44 term_prime: '*' factor term_prime
   45           | '/' factor term_prime
   46           | '%' factor term_prime
   47           | '~' factor term_prime
   48           | 'k' factor term_prime
   49           | ε

   50 factor: ATOM_PAR_IZQ expr ATOM_PAR_DER
   51       | ATOM_ID factor_prime
   52       | ATOM_ENTERO
   53       | ATOM_REAL
   54       | llama_func

   55 factor_prime: ATOM_INC
   56             | ATOM_DEC

   57 llama_func: ATOM_LLAVE_IZQ ATOM_ID ATOM_PAR_IZQ list_param ATOM_PAR_DER ATOM_LLAVE_DER

   58 list_param: expr_gral param
   59           | ε

   60 param: ATOM_COMA expr_gral param
   61      | ε

   62 exp_rel: expr op_rel expr

   63 op_rel: '>'
   64       | '<'
   65       | 'i'
   66       | '!'
   67       | 'x'
   68       | 'y'

   69 haz_mientras: ATOM_HAZ ATOM_COR_IZQ lista_sent ATOM_COR_DER ATOM_MIENTRAS ATOM_PAR_IZQ exp_rel ATOM_PAR_DER

   70 si: ATOM_SI ATOM_PAR_IZQ exp_rel ATOM_PAR_DER ATOM_COR_IZQ lista_sent ATOM_COR_DER sino

   71 sino: ATOM_SINO ATOM_COR_IZQ lista_sent ATOM_COR_DER
   72     | ε

   73 para: ATOM_PARA ATOM_PAR_IZQ expr ATOM_PAR_DER ATOM_COR_IZQ lista_sent ATOM_COR_DER

   74 dev: ATOM_DEV ATOM_PAR_IZQ val_ret ATOM_PAR_DER ATOM_PUNTO

   75 val_ret: expr_gral
   76        | ε


